{
  "entries": [
    {
      "kind": "connector",
      "id": "github",
      "name": "GitHub",
      "description": "Repositories, issues, pull requests and the rest of what the GitHub MCP server serves.",
      "homepage": "https://github.com/github/github-mcp-server",
      "config": {
        "transport": {
          "kind": "http",
          "url": "https://api.githubcopilot.com/mcp/x/all",
