{
  "entries": [
    {
      "kind": "connector",
      "id": "github",
      "name": "GitHub",
      "description": "Repositories, issues, pull requests and the rest of what the GitHub MCP server serves.",
      "homepage": "https://github.com/github/github-mcp-server",
      "config": {
        "transport": {
          "kind": "http",
          "url": "https://api.githubcopilot.com/mcp/x/all",
          "headers": {
            "X-MCP-Lockdown": "true"
          }
        },
        "clientId": "<the Hearthscale GitHub App client id>",
        "scope": "read:user read:org repo"
      },
      "source": {
        "publisher": "hearthscale"
      }
    },
    {
      "kind": "app",
      "id": "ash",
      "name": "Ash",
      "version": "0.3.0",
      "api": 1,
      "description": "Knowledge work over your own computer, in one chat.",
      "author": "T-R3x3r",
      "homepage": "https://github.com/T-R3x3r/ash",
      "license": "MIT",
      "url": "https://github.com/T-R3x3r/ash/releases/download/0.3.0/ash-0.3.0.zip",
      "sha256": "005e17d4da130f0c88cded55dfc1f8317d0b13e6110e69005384c9a122933539",
      "bytes": 2876,
      "icon": "data:image/svg+xml;base64,",
      "source": {
        "repo": "T-R3x3r/ash",
        "publisher": "T-R3x3r",
        "firstPublished": "2026-09-07T18:36:12Z"
      },
      "facts": [
        "model:chat:tools:images",
        "path:~",
        "path:~/Hearthscale/Ash",
        "recommends:artifacts",
        "recommends:browser",
        "recommends:schedules",
        "tool:delegate:::",
        "uses:exec",
        "uses:roots",
        "uses:sessions",
        "uses:sessions.spawn",
        "uses:tools.file",
        "uses:tools.image"
      ]
    },
    {
      "kind": "plugin",
      "id": "artifacts",
      "name": "Artifacts",
      "version": "0.1.0",
      "api": 1,
      "description": "An artifact that runs. Attach it to any app and its agent can raise a single .html page — a calculator, a form, a little tool — in the Artifact panel, where the page's own script answers clicks. The page is served under a policy computed from its own scripts, it reaches no network, and it never reaches the model.",
      "author": "T-R3x3r",
      "homepage": "https://github.com/T-R3x3r/hearthscale-artifacts",
      "license": "MIT",
      "url": "https://github.com/T-R3x3r/hearthscale-artifacts/releases/download/0.1.0/artifacts-0.1.0.zip",
      "sha256": "60a94778bd25eb0ab19b66f229da3c19baa7f16a78f171f0088d6298dad6a66a",
      "bytes": 2751,
      "icon": "data:image/svg+xml;base64,",
      "source": {
        "repo": "T-R3x3r/hearthscale-artifacts",
        "publisher": "T-R3x3r",
        "firstPublished": "2026-09-07T23:42:59Z"
      },
      "facts": ["publishes:artifacts", "tool:artifact_show:::"]
    }
  ]
}
